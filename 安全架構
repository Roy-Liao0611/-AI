# 4. LLM 門戶層 (MockLLMAdapter)
# =====================================================================
class MockLLMAdapter:
    """
    架構驗證用 Mock，模擬 AI 決策鏈：
    寫入 → 讀取確認 → 嘗試路徑逃逸（應被阻斷）→ 完成
    """

    def __init__(self):
        self._step = 0

    def chat(self, messages: List[Dict[str, Any]]) -> Dict[str, Any]:
        self._step += 1
        steps = {
            1: {
                "role": "assistant",
                "content": "思考：使用 write_file 建立報告。",
                "tool_calls": [{
                    "name": "write_file",
                    "arguments": {
                        "filename": "report.txt",
                        "content": "Hello Local AI Sandbox!",
                    }
                }],
            },
            2: {
                "role": "assistant",
                "content": "思考：讀取報告確認寫入正確。",
                "tool_calls": [{
                    "name": "read_file",
                    "arguments": {"filename": "report.txt"},
                }],
            },
            3: {
                "role": "assistant",
                "content": "思考：[安全測試] 嘗試讀取沙盒外敏感路徑。",
                "tool_calls": [{
                    "name": "read_file",
                    "arguments": {"filename": "../../../etc/passwd"},
                }],
            },
            4: {
                "role": "assistant",
                "content": "思考：[安全測試] 嘗試執行帶有 Shell 注入的指令。",
                "tool_calls": [{
                    "name": "execute_system_command",
                    "arguments": {"command": "echo hello; cat /etc/passwd"},
                }],
            },
        }
        if self._step in steps:
            return steps[self._step]
        return {
            "role": "assistant",
            "content": (
                "任務完成。\n"
                "✅ 報告建立成功\n"
                "✅ 讀取驗證成功\n"
                "🛡️ 路徑逃逸攻擊被成功阻斷\n"
                "🛡️ Shell 注入攻擊被成功阻斷"
            ),
            "tool_calls": None,
        }


# =====================================================================
# 5. Agent 核心循環 (Agent Engine)
# =====================================================================
class AgentEngine:
    """
    [V-4 修復] 新增 max_memory_turns 限制，防止記憶體無限增長。
    """

    def __init__(
        self,
        llm_adapter: MockLLMAdapter,
        registry: ToolRegistry,
        max_loops: int = 10,
        max_memory_turns: int = 50,
    ):
        self._llm = llm_adapter
        self._registry = registry
        self._max_loops = max_loops
        self._max_memory_turns = max_memory_turns
        self._memory: List[Dict[str, Any]] = []

    def _trim_memory(self) -> None:
        """保留最後 max_memory_turns 條記錄（始終保留第一條 user 訊息）"""
        if len(self._memory) > self._max_memory_turns:
            # 保留 system/首則訊息 + 最新的 N 條
            head = self._memory[:1]
            tail = self._memory[-(self._max_memory_turns - 1):]
            self._memory = head + tail
            logger.info("記憶體裁剪完成，防止無限增長。")

    def run(self, user_prompt: str) -> None:
        logger.info(f"啟動 Agent 任務: {user_prompt!r}")
        self._memory.append({"role": "user", "content": user_prompt})

        for loop_count in range(1, self._max_loops + 1):
            logger.info(f"=== [Loop {loop_count}/{self._max_loops}] Plan-Act-Observe ===")

            # Plan
            response = self._llm.chat(self._memory)
            self._memory.append(response)
            self._trim_memory()

            print(f"\n[AI]: {response['content']}")

            tool_calls: Optional[List[Dict]] = response.get("tool_calls")
            if not tool_calls:
                logger.info("AI 確認任務完成。")
                break

            # Act & Observe
            for tool_call in tool_calls:
                tool_name = tool_call.get("name", "")
                args = tool_call.get("arguments", {})

                if not isinstance(args, dict):
                    observation = "錯誤：工具參數格式非 dict"
                else:
                    observation = self._registry.execute(tool_name, args)

                print(f"[Observation] {tool_name}: {observation}")

                self._memory.append({
                    "role": "tool",
                    "tool_name": tool_name,
                    "content": observation,
                })
        else:
            logger.warning("達到最大循環次數，強制終止。")


