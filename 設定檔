"""
chat_layer/config.py
────────────────────
所有可調整的參數集中於此，修改時不需動其他模組。

目前模型：gemma3:1b
  - 1B 參數，context window 128k，本機 CPU 也能跑
  - 相較 8B 模型需要較低 temperature（0.6）才穩定，
    max_tokens 調低至 300 讓回應更精練
  - max_context_turns 調低至 10，避免小模型 context 過載
"""
from dataclasses import dataclass
from pathlib import Path

# 記憶體檔案預設存放在 chat_layer/memory/ 目錄下
_MEMORY_DIR = Path(__file__).parent / "memory"
_MEMORY_DIR.mkdir(exist_ok=True)


@dataclass
class ChatConfig:
    # ── Ollama ──────────────────────────────────────────────────────
    model: str = "gemma3:1b"             # ← Gemma 3 1B
    ollama_base_url: str = "http://localhost:11434"
    temperature: float = 0.6             # 1B 模型用低一點更穩
    max_tokens: int = 300                # 小模型短回應反而更自然

    # ── 記憶體 ──────────────────────────────────────────────────────
    memory_file: Path = _MEMORY_DIR / "chat_history.json"
    # 1B context 128k，但輸入越長越容易跑偏，保守設 10
    max_context_turns: int = 10

    # ── 防重複 ──────────────────────────────────────────────────────
    recent_turns_to_check: int = 4
    # 1B 模型較容易重複，threshold 稍微調嚴
    repetition_threshold: float = 0.50
    temperature_boost: float = 0.15
    max_retries: int = 2

    # ── System Prompt ────────────────────────────────────────────────
    system_prompt: str = (
        "你是一個親切、自然的對話夥伴，說話像真實朋友一樣輕鬆。\n"
        "規則：\n"
        "1. 每次回應控制在 1–3 句以內，不要寫長篇大論。\n"
        "2. 禁止使用條列格式（- 或數字清單），用口語句子表達。\n"
        "3. 不要重複自己剛剛說過的話或措辭。\n"
        "4. 如果不確定，直接說不知道，不要捏造答案。\n"
        "5. 語氣自然，可以帶一點個性，但保持友善。"
    )


# 全域預設設定，直接 import 使用
DEFAULT_CONFIG = ChatConfig()
